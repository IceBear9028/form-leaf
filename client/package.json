{
  "name": "resume-studio",
  "productName": "Resume Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first resume editor",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "app": "npm run build && npm start",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:markdown && npm run test:migration && npm run test:styles && npm run test:library",
    "test:markdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/markdown.test.mjs",
    "test:migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/resume-migration.test.mjs",
    "test:styles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/resume-style-sheets.test.mjs",
    "test:library": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-library.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
