{
  "name": "document",
  "productName": "Document",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first document editor",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "app": "npm run build && npm start",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:document-core && npm run test:legacy-import && npm run test:renderer && npm run test:editor && npm run test:markdown && npm run test:pagination && npm run test:migration && npm run test:styles && npm run test:storage && npm run test:library",
    "test:document-core": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-core.test.mjs",
    "test:legacy-import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/legacy-document-import.test.mjs",
    "test:renderer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-renderer.test.mjs",
    "test:editor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-editor.test.mjs",
    "test:markdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/markdown.test.mjs",
    "test:pagination": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/pagination.test.mjs",
    "test:migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-migration.test.mjs",
    "test:styles": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/resume-style-sheets.test.mjs",
    "test:storage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-storage.test.mjs",
    "test:library": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-library.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
