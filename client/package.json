{
  "name": "formleaf",
  "productName": "Formleaf",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first document editor",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "app": "node scripts/run-app.mjs",
    "app:debug": "node scripts/run-app.mjs --debug",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:app",
    "test": "npm run test:document-core && npm run test:style-presets && npm run test:legacy-import && npm run test:canonical-migration && npm run test:renderer && npm run test:render-pipeline && npm run test:editor && npm run test:component-reuse && npm run test:direct-edit && npm run test:markdown && npm run test:markdown-editor-session && npm run test:pagination && npm run test:migration && npm run test:storage && npm run test:library && npm run test:agent-contracts && npm run test:agent-service && npm run test:agent-access && npm run test:agent-reads && npm run test:agent-content && npm run test:agent-structure && npm run test:agent-components && npm run test:agent-style && npm run test:agent-output && npm run test:agent-history && npm run test:analysis && npm run test:boundaries && npm run test:promises && npm run test:type-safety",
    "test:document-core": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-core.test.mjs",
    "test:style-presets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-style-presets.test.mjs",
    "test:legacy-import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/legacy-document-import.test.mjs",
    "test:canonical-migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/canonical-document-migration.test.mjs",
    "test:renderer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-renderer.test.mjs",
    "test:render-pipeline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-render-pipeline.test.mjs",
    "test:editor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-editor.test.mjs",
    "test:component-reuse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-component-reuse.test.mjs",
    "test:direct-edit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-direct-edit.test.mjs",
    "test:markdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/markdown.test.mjs",
    "test:markdown-editor-session": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/markdown-editor-session.test.mjs",
    "test:e2e:markdown": "npm run build && playwright test e2e/markdown-user-flow.spec.ts",
    "test:pagination": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/pagination.test.mjs",
    "test:migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-migration.test.mjs",
    "test:storage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-storage.test.mjs",
    "test:library": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/document-library.test.mjs",
    "test:agent-contracts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-contracts.test.mjs",
    "test:agent-service": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-document-service.test.mjs",
    "test:agent-access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-access.test.mjs",
    "test:agent-reads": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-reads.test.mjs",
    "test:agent-content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-content.test.mjs",
    "test:agent-structure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-structure.test.mjs",
    "test:agent-components": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-components.test.mjs",
    "test:agent-style": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-style.test.mjs",
    "test:agent-output": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-output.test.mjs",
    "test:agent-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-history.test.mjs",
    "test:agent-codex": "npm run build && playwright test e2e/agent-external-client.spec.ts",
    "test:agent-load": "npm run build && playwright test e2e/agent-load.spec.ts",
    "test:agent-claude-discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/agent-client-discovery.test.mjs",
    "typecheck:app": "tsc -p tsconfig.foundation.json && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tools.json",
    "lint:app": "eslint src electron.vite.config.ts",
    "lint:tools": "eslint scripts eslint.config.mjs",
    "lint": "npm run lint:app && npm run lint:tools",
    "check": "npm run typecheck && npm run lint",
    "test:analysis": "node --test test/analysis-tooling.test.mjs",
    "test:boundaries": "node --test test/layer-boundaries.test.mjs",
    "test:promises": "node --test test/promise-ownership.test.mjs",
    "test:type-safety": "node --test test/type-safety.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "vite": "^7.1.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=24"
  }
}
